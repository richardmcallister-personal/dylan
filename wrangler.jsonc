{
  "name": "dylan",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "bobdylan.app", "custom_domain": true },
    { "pattern": "www.bobdylan.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "DYLAN_CACHE", "id": "9366b3689b1145d4927c903b466419a4" }
  ],
  "observability": { "enabled": true }
}
